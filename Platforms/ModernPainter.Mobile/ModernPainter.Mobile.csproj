<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Use ONLY TargetFrameworks for multi-targeting -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationId>com.idk.mpainter</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Embed the .NET assemblies into the APK so it is self-contained and
         works with a plain `adb install` (no Fast Deployment / __override__ dependency) -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidFastDeploymentType>none</AndroidFastDeploymentType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ModernPainter/ModernPainter.Core.csproj" />
  </ItemGroup>

</Project>